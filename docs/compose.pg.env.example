# Replace this placeholder with your own image built from this repository.
FILEBROWSER_IMAGE=registry.example.com/filebrowser:pg
# This port is exposed on the host; config.yaml must use http.port: 80.
FILEBROWSER_HTTP_PORT=8080
# Generic example paths; replace them with your own directories.
FILEBROWSER_FILES=/path/to/files
FILEBROWSER_CONFIG_DIR=./data/config
FILEBROWSER_CACHE_DIR=./data/cache
# Keep the existing FileBrowser admin password. This does not reset existing users.
FILEBROWSER_ADMIN_PASSWORD=REPLACE_WITH_EXISTING_PASSWORD
# Use `openssl rand -hex 32`; hex needs no URI escaping in FILEBROWSER_INDEX_DSN.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
# PostgreSQL 18 stores data below /var/lib/postgresql/18/docker in the container.
# Prefer a local SSD directory here when available.
FILEBROWSER_PG_DATA=./data/postgres
